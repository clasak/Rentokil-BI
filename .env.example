# =============================================================================
# Rentokil BI Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# Data Source Configuration
# =============================================================================

# Primary data source selector
# Options: mock | rtx | salesforce | bigquery | hybrid
#   - mock: Use synthetic demo data (default)
#   - rtx: Use RTX Data Hub REST API
#   - salesforce: Use Salesforce CRM
#   - bigquery: Use RTX Data Hub BigQuery warehouse (read-only)
#   - hybrid: Try RTX first, fallback to mock if unavailable
NEXT_PUBLIC_DATA_SOURCE=mock

# Legacy compatibility (deprecated - use NEXT_PUBLIC_DATA_SOURCE instead)
NEXT_PUBLIC_USE_MOCK_DATA=true

# =============================================================================
# RTX Data Hub REST API Configuration
# =============================================================================
# Required when NEXT_PUBLIC_DATA_SOURCE=rtx or hybrid

# RTX Data Hub API endpoint
# Get from: IT > Data Platform > RTX Access Request
RTX_API_ENDPOINT=https://rtx-data-hub.rentokil.com/api/v1

# RTX API Key for authentication
# Get from: IT > Data Platform > API Key Management
RTX_API_KEY=

# Request timeout in milliseconds (default: 30000)
RTX_API_TIMEOUT=30000

# =============================================================================
# Google BigQuery Configuration
# =============================================================================
# Required when NEXT_PUBLIC_DATA_SOURCE=bigquery
# For read-only access to RTX Data Hub warehouse

# BigQuery environment: production | staging | dev
# Maps to GCP projects:
#   - production: bidata-sharedus-production
#   - staging: bidata-sharedus-staging
#   - dev: bidata-sharedus-dev
BIGQUERY_ENVIRONMENT=dev

# Override GCP project ID (optional - defaults based on BIGQUERY_ENVIRONMENT)
# GOOGLE_CLOUD_PROJECT=bidata-sharedus-dev

# Default dataset to query from (optional)
# Set this after using /api/bigquery/discover to find available datasets
# BIGQUERY_DATASET=

# BigQuery location (default: US)
BIGQUERY_LOCATION=US

# Request timeout in milliseconds (default: 30000)
BIGQUERY_TIMEOUT=30000

# Path to service account key file (optional)
# For local development, use: gcloud auth application-default login
# For production, use Workload Identity or service account
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# =============================================================================
# Salesforce Configuration
# =============================================================================
# Required when NEXT_PUBLIC_DATA_SOURCE=salesforce

# Salesforce login URL
# Use https://login.salesforce.com for production
# Use https://test.salesforce.com for sandbox
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Salesforce credentials
# Get from: Salesforce Admin > User Settings
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# =============================================================================
# Supabase Configuration (optional backend)
# =============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key
# Found in: Supabase Dashboard > Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Optional: Supabase Service Role Key (for server-side operations)
# =============================================================================

# Only needed for server-side operations that bypass RLS
# Found in: Supabase Dashboard > Settings > API > service_role
# WARNING: Never expose this in client-side code!
# SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Dev Role Mappings (Local Development Only)
# =============================================================================
# Simulate a specific user for local testing without Supabase authentication
# Set to an email from src/lib/dev-role-mappings.ts to test as that user
# Only works when NODE_ENV !== 'production'
#
# Available dev users:
#   - susan.michael@rentokil.com (exec)
#   - kenneth.diotte@rentokil.com (market_vp - Midwest)
#   - adam.grier@rentokil.com (market_sales_director - Midwest)
#   - hal.johnson@rentokil.com (region_director - Region 54)
#   - andrew.kasel@rentokil.com (region_sales_manager - Region 54)
#   - joaquin.barrera@prestox.com (manager - Branch 98)
#   - jacob.bernal@prestox.com (sales_manager - Branch 098)
#   - bruce.hockless@prestox.com (ops_manager - Branch 98)
#   - cody.lytle@prestox.com (rep - Branch 098)
#   - jesus.corral@prestox.com (technician)
#
# Example:
# NEXT_PUBLIC_DEV_USER_EMAIL=kenneth.diotte@rentokil.com
#
# To switch users, change this value and restart dev server
# NEXT_PUBLIC_DEV_USER_EMAIL=

# =============================================================================
# Google Sheets Integration (New Start Log Export)
# =============================================================================
# Optional: Enable export of New Start Log data to Google Sheets
# See: /docs/GOOGLE-SHEETS-INTEGRATION-GUIDE.md for full setup instructions

# Google Sheets API credentials (from service account JSON file)
# Format: Keep the \n line breaks intact when copying from JSON file
# GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Service account email address
# GOOGLE_SHEETS_CLIENT_EMAIL=rentokil-bi-sheets-sync@project-id.iam.gserviceaccount.com

# Target Google Sheet ID (from sheet URL)
# Example URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
# GOOGLE_SHEETS_NEW_START_LOG_ID=

# =============================================================================
# Mapbox Configuration (for route mapping)
# =============================================================================

# Mapbox public access token for route visualization
# Get from: Mapbox Dashboard > Access tokens
# Required for: Technician route map display
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# =============================================================================
# Push Notifications Configuration (PWA)
# =============================================================================

# VAPID Public Key for Web Push notifications
# Required for: Push notification subscription in PWA
#
# Generate VAPID keys using one of these methods:
#
# Method 1 - Using web-push npm package:
#   npx web-push generate-vapid-keys
#
# Method 2 - Using Node.js:
#   node -e "const wp = require('web-push'); const keys = wp.generateVAPIDKeys(); console.log(keys);"
#
# Method 3 - Online generator:
#   https://vapidkeys.com/
#
# The public key goes here (client-side, safe to expose)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# The private key should be stored securely (server-side only)
# VAPID_PRIVATE_KEY=

# Contact email for VAPID (required by spec)
# VAPID_CONTACT_EMAIL=admin@rentokil.com
