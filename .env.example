# =============================================================================
# Rentokil BI Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# Data Source Configuration
# =============================================================================

# Set to 'false' to use Supabase instead of mock data
# Default: true (uses synthetic demo data)
NEXT_PUBLIC_USE_MOCK_DATA=true

# =============================================================================
# Supabase Configuration (required if USE_MOCK_DATA=false)
# =============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key
# Found in: Supabase Dashboard > Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Optional: Supabase Service Role Key (for server-side operations)
# =============================================================================

# Only needed for server-side operations that bypass RLS
# Found in: Supabase Dashboard > Settings > API > service_role
# WARNING: Never expose this in client-side code!
# SUPABASE_SERVICE_ROLE_KEY=
