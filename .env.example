# =============================================================================
# Rentokil BI Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# Data Source Configuration
# =============================================================================

# Primary data source selector
# Options: mock | rtx | salesforce | hybrid
#   - mock: Use synthetic demo data (default)
#   - rtx: Use RTX Data Hub enterprise warehouse
#   - salesforce: Use Salesforce CRM
#   - hybrid: Try RTX first, fallback to mock if unavailable
NEXT_PUBLIC_DATA_SOURCE=mock

# Legacy compatibility (deprecated - use NEXT_PUBLIC_DATA_SOURCE instead)
NEXT_PUBLIC_USE_MOCK_DATA=true

# =============================================================================
# RTX Data Hub Configuration
# =============================================================================
# Required when NEXT_PUBLIC_DATA_SOURCE=rtx or hybrid

# RTX Data Hub API endpoint
# Get from: IT > Data Platform > RTX Access Request
RTX_API_ENDPOINT=https://rtx-data-hub.rentokil.com/api/v1

# RTX API Key for authentication
# Get from: IT > Data Platform > API Key Management
RTX_API_KEY=

# Request timeout in milliseconds (default: 30000)
RTX_API_TIMEOUT=30000

# =============================================================================
# Salesforce Configuration
# =============================================================================
# Required when NEXT_PUBLIC_DATA_SOURCE=salesforce

# Salesforce login URL
# Use https://login.salesforce.com for production
# Use https://test.salesforce.com for sandbox
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# Salesforce credentials
# Get from: Salesforce Admin > User Settings
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# =============================================================================
# Supabase Configuration (optional backend)
# =============================================================================

# Your Supabase project URL
# Found in: Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key
# Found in: Supabase Dashboard > Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Optional: Supabase Service Role Key (for server-side operations)
# =============================================================================

# Only needed for server-side operations that bypass RLS
# Found in: Supabase Dashboard > Settings > API > service_role
# WARNING: Never expose this in client-side code!
# SUPABASE_SERVICE_ROLE_KEY=
