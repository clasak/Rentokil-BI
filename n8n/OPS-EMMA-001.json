{
  "name": "OPS-EMMA-001 Engagement Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Daily at 6am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app/api/engagement/summary",
        "options": {
          "timeout": 30000
        }
      },
      "id": "get-engagement",
      "name": "Get Engagement Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "// Process engagement data\nconst input = $input.first().json;\nconst summary = input.summary;\nconst trends = input.trends;\nconst alerts = input.alerts || [];\n\nconst hasLowEngagement = input.status === 'low_engagement';\nconst hasAlerts = alerts.length > 0;\n\n// Format top pages for Slack\nconst topPagesFormatted = summary?.top_pages?.slice(0, 5).map((p, i) => \n  `${i + 1}. ${p.route}: ${p.views} views`\n).join('\\n') || 'No data';\n\n// Format engagement by role\nconst roleEngagement = summary?.engagement_by_role || {};\nconst roleFormatted = Object.entries(roleEngagement)\n  .map(([role, count]) => `• ${role}: ${count}`)\n  .join('\\n') || 'No data';\n\n// Trend indicator\nconst trendEmoji = trends?.trend_direction === 'up' ? '📈' : \n                   trends?.trend_direction === 'down' ? '📉' : '➡️';\n\nreturn [{\n  json: {\n    hasLowEngagement,\n    hasAlerts,\n    alerts,\n    summary,\n    trends,\n    topPagesFormatted,\n    roleFormatted,\n    trendEmoji,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "process-engagement",
      "name": "Process Engagement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "engagement_summary",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "summary_date": "={{ $json.summary?.summary_date || $now.format('yyyy-MM-dd') }}",
            "total_users": "={{ $json.summary?.total_users || 0 }}",
            "active_users": "={{ $json.summary?.active_users || 0 }}",
            "new_users": "={{ $json.summary?.new_users || 0 }}",
            "returning_users": "={{ $json.summary?.returning_users || 0 }}",
            "total_sessions": "={{ $json.summary?.total_sessions || 0 }}",
            "avg_session_duration_seconds": "={{ $json.summary?.avg_session_duration_seconds || 0 }}",
            "top_pages": "={{ JSON.stringify($json.summary?.top_pages || []) }}",
            "engagement_by_role": "={{ JSON.stringify($json.summary?.engagement_by_role || {}) }}"
          }
        },
        "options": {
          "onConflict": "nothing"
        }
      },
      "id": "save-summary",
      "name": "Save Summary",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [660, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Supabase-Prod"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-alerts",
              "leftValue": "={{ $('Process Engagement').item.json.hasAlerts }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "has-alerts",
      "name": "Has Alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "ops_events",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "event_type": "engagement_alert",
            "severity": "medium",
            "source": "emma",
            "route": "/api/engagement/summary",
            "message": "={{ 'Low engagement detected: ' + $('Process Engagement').item.json.alerts.join('; ') }}",
            "metadata": "={{ JSON.stringify($('Process Engagement').item.json) }}",
            "created_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "log-alert",
      "name": "Log Engagement Alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, -100],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Supabase-Prod"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_SLACK_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"attachments\": [\n    {\n      \"color\": \"#FFA500\",\n      \"blocks\": [\n        {\n          \"type\": \"header\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"📊 Daily Engagement Report (Low Activity)\",\n            \"emoji\": true\n          }\n        },\n        {\n          \"type\": \"section\",\n          \"text\": {\n            \"type\": \"mrkdwn\",\n            \"text\": \"*Alerts:*\\n{{ $('Process Engagement').item.json.alerts.map(a => '⚠️ ' + a).join('\\\\n') }}\"\n          }\n        },\n        {\n          \"type\": \"divider\"\n        },\n        {\n          \"type\": \"section\",\n          \"fields\": [\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*Active Users:*\\n{{ $('Process Engagement').item.json.summary?.active_users || 0 }}\"\n            },\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*Sessions:*\\n{{ $('Process Engagement').item.json.summary?.total_sessions || 0 }}\"\n            },\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*Trend:*\\n{{ $('Process Engagement').item.json.trendEmoji }} {{ $('Process Engagement').item.json.trends?.dau_change_pct || 0 }}%\"\n            },\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*Agent:*\\nEmma (Engagement)\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"text\": {\n            \"type\": \"mrkdwn\",\n            \"text\": \"*Top Pages:*\\n{{ $('Process Engagement').item.json.topPagesFormatted }}\"\n          }\n        },\n        {\n          \"type\": \"section\",\n          \"text\": {\n            \"type\": \"mrkdwn\",\n            \"text\": \"<https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app/admin|📊 Admin Dashboard>\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "slack-alert",
      "name": "Slack Low Engagement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -100]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "ops_events",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "event_type": "engagement_summary",
            "severity": "info",
            "source": "emma",
            "route": "/api/engagement/summary",
            "message": "={{ 'Daily engagement: ' + ($('Process Engagement').item.json.summary?.active_users || 0) + ' active users, ' + ($('Process Engagement').item.json.summary?.total_sessions || 0) + ' sessions' }}",
            "metadata": "={{ JSON.stringify($('Process Engagement').item.json.summary || {}) }}",
            "created_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "log-success",
      "name": "Log Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1100, 100],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Supabase-Prod"
        }
      }
    }
  ],
