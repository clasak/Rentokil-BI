        "jsCode": "// Determine which agents to run based on current time\nconst now = new Date();\nconst minute = now.getMinutes();\nconst hour = now.getUTCHours();\n\n// Calculate execution flags based on schedule\nconst flags = {\n  // Every 5 minutes (always run)\n  runTimmy: true,          // Health monitoring\n  runPete: true,           // Performance monitoring\n  runRTXHealth: true,      // RTX connection status\n\n  // Every 10 minutes\n  runSophia: minute % 10 === 0,  // Feedback triage\n\n  // Every 15 minutes\n  runTommy: minute % 15 === 0,   // KPI snapshots\n  runSam: minute % 15 === 0,     // Security monitoring\n\n  // Every 30 minutes\n  runBailey: minute % 30 === 0,  // Business alerts\n  runDerek: minute % 30 === 0,   // Deployment monitoring\n  runRTXIntegrity: minute % 30 === 0, // Data quality checks\n\n  // Every hour (at minute 0)\n  runTina: minute === 0,         // Governance checks\n  runReconcile: minute === 0,    // KPI reconciliation\n\n  // Daily at 6am UTC\n  runEmma: minute === 0 && hour === 6,  // Engagement metrics\n\n  // Metadata\n  timestamp: now.toISOString(),\n  minute,\n  hour\n};\n\nreturn [{ json: flags }];"
      },
