    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_SLACK_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"attachments\": [\n    {\n      \"color\": \"{{ $('Process Results').item.json.alerts.some(a => a.severity === 'critical') ? '#FF0000' : '#FFA500' }}\",\n      \"blocks\": [\n        {\n          \"type\": \"header\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"{{ $('Process Results').item.json.alerts.some(a => a.severity === 'critical') ? '🚨 CRITICAL ALERT' : '⚠️ Warning Alert' }}\",\n            \"emoji\": true\n          }\n        },\n        {\n          \"type\": \"section\",\n          \"text\": {\n            \"type\": \"mrkdwn\",\n            \"text\": \"*{{ $('Process Results').item.json.alerts.length }} alert(s) detected*\\n\\n{{ $('Process Results').item.json.alerts.map(a => '• *' + a.agent + '* (' + a.type + '): ' + a.message).join('\\n') }}\"\n          }\n        },\n        {\n          \"type\": \"context\",\n          \"elements\": [\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"Agent: Unified Monitor | {{ $now.toISO() }}\"\n            }\n          ]\n        },\n        {\n          \"type\": \"actions\",\n          \"elements\": [\n            {\n              \"type\": \"button\",\n              \"text\": {\n                \"type\": \"plain_text\",\n                \"text\": \"View Dashboard\"\n              },\n              \"url\": \"https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
