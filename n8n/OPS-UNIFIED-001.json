    {
      "parameters": {
        "jsCode": "// Process results and check for alerts\nconst scheduleData = $('Schedule Router').item.json;\nconst results = {\n  timestamp: new Date().toISOString(),\n  minute: scheduleData.minute,\n  hour: scheduleData.hour,\n  agents: [],\n  alerts: [],\n  logs: []\n};\n\n// Helper to safely get node data\nfunction getNodeData(nodeName) {\n  try {\n    const items = $input.all();\n    for (const item of items) {\n      if (item.json && item.json._source === nodeName) {\n        return item.json;\n      }\n    }\n    return null;\n  } catch {\n    return null;\n  }\n}\n\n// Timmy - Health Check (always runs)\ntry {\n  const health = $('Timmy: Health Check').item?.json;\n  if (health) {\n    const isHealthy = health.status === 'healthy';\n    results.agents.push({ name: 'Timmy', ran: true, status: isHealthy ? 'ok' : 'alert' });\n    results.logs.push({\n      event_type: 'health_check',\n      severity: isHealthy ? 'info' : 'critical',\n      source: 'timmy',\n      message: isHealthy ? 'Health check passed' : 'Health check failed: ' + (health.status || 'unknown')\n    });\n    if (!isHealthy) {\n      results.alerts.push({\n        agent: 'Timmy',\n        type: 'health',\n        severity: 'critical',\n        message: 'System health check failed'\n      });\n    }\n  }\n} catch (e) {\n  results.agents.push({ name: 'Timmy', ran: true, status: 'error', error: e.message });\n}\n\n// Pete - Performance (always runs)\ntry {\n  const perf = $('Pete: Performance').item?.json;\n  if (perf) {\n    const isSlaOk = !perf.sla_breach;\n    results.agents.push({ name: 'Pete', ran: true, status: isSlaOk ? 'ok' : 'warning' });\n    results.logs.push({\n      event_type: 'performance',\n      severity: isSlaOk ? 'info' : 'warning',\n      source: 'pete',\n      message: isSlaOk ? 'Performance within SLA' : 'SLA breach detected: p95 > 2000ms'\n    });\n    if (!isSlaOk) {\n      results.alerts.push({\n        agent: 'Pete',\n        type: 'performance',\n        severity: 'warning',\n        message: 'Performance SLA breach'\n      });\n    }\n  }\n} catch (e) {\n  results.agents.push({ name: 'Pete', ran: true, status: 'error', error: e.message });\n}\n\n// RTX Health (always runs)\ntry {\n  const rtx = $('RTX: Health Check').item?.json;\n  if (rtx) {\n    const isHealthy = rtx.status === 'healthy';\n    results.agents.push({ name: 'RTX Health', ran: true, status: isHealthy ? 'ok' : 'critical' });\n    results.logs.push({\n      event_type: 'rtx_health',\n      severity: isHealthy ? 'info' : 'critical',\n      source: 'rtx',\n      message: isHealthy ? 'RTX connection healthy' : 'RTX connection issue: ' + (rtx.status || 'unknown')\n    });\n    if (!isHealthy) {\n      results.alerts.push({\n        agent: 'RTX Health',\n        type: 'rtx',\n        severity: 'critical',\n        message: 'RTX Data Hub connection issue'\n      });\n    }\n  }\n} catch (e) {\n  results.agents.push({ name: 'RTX Health', ran: true, status: 'error', error: e.message });\n}\n\n// Conditional agents - only process if they ran\nif (scheduleData.runSophia) {\n  results.agents.push({ name: 'Sophia', ran: true, status: 'ok' });\n}\n\nif (scheduleData.runTommy) {\n  try {\n    const kpis = $('Tommy: KPI Health').item?.json;\n    if (kpis) {\n      const hasCritical = kpis.kpis?.some(k => k.status === 'critical');\n      results.agents.push({ name: 'Tommy', ran: true, status: hasCritical ? 'alert' : 'ok' });\n      if (hasCritical) {\n        results.alerts.push({\n          agent: 'Tommy',\n          type: 'kpi',\n          severity: 'critical',\n          message: 'Critical KPIs detected'\n        });\n      }\n    }\n  } catch (e) {\n    results.agents.push({ name: 'Tommy', ran: true, status: 'error', error: e.message });\n  }\n}\n\nif (scheduleData.runSam) {\n  try {\n    const security = $('Sam: Security Threats').item?.json;\n    if (security) {\n      const hasThreats = security.threats?.length > 0;\n      results.agents.push({ name: 'Sam', ran: true, status: hasThreats ? 'alert' : 'ok' });\n      if (hasThreats) {\n        results.alerts.push({\n          agent: 'Sam',\n          type: 'security',\n          severity: 'critical',\n          message: 'Security threats detected'\n        });\n      }\n    }\n  } catch (e) {\n    results.agents.push({ name: 'Sam', ran: true, status: 'error', error: e.message });\n  }\n}\n\nif (scheduleData.runBailey) {\n  results.agents.push({ name: 'Bailey', ran: true, status: 'ok' });\n}\n\nif (scheduleData.runDerek) {\n  results.agents.push({ name: 'Derek', ran: true, status: 'ok' });\n}\n\nif (scheduleData.runTina) {\n  results.agents.push({ name: 'Tina', ran: true, status: 'ok' });\n}\n\nif (scheduleData.runReconcile) {\n  try {\n    const recon = $('Tommy: Reconcile').item?.json;\n    if (recon) {\n      const hasFailures = recon.summary?.fail > 0;\n      results.agents.push({ name: 'Reconcile', ran: true, status: hasFailures ? 'warning' : 'ok' });\n      if (hasFailures) {\n        results.alerts.push({\n          agent: 'Tommy',\n          type: 'reconcile',\n          severity: 'warning',\n          message: 'Reconciliation failures detected'\n        });\n      }\n    }\n  } catch (e) {\n    results.agents.push({ name: 'Reconcile', ran: true, status: 'error', error: e.message });\n  }\n}\n\nif (scheduleData.runEmma) {\n  results.agents.push({ name: 'Emma', ran: true, status: 'ok' });\n}\n\nreturn [{ json: results }];"
      },
      "id": "process-results",
      "name": "Process Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 600]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Generate log entries for database\nconst results = $input.first().json;\nconst logEntries = [];\n\nfor (const log of results.logs || []) {\n  logEntries.push({\n    json: {\n      event_type: log.event_type,\n      severity: log.severity,\n      source: log.source,\n      route: '/api/unified-monitor',\n      message: log.message,\n      metadata: JSON.stringify({\n        minute: results.minute,\n        hour: results.hour,\n        agents_ran: results.agents.filter(a => a.ran).map(a => a.name)\n      }),\n      created_at: results.timestamp\n    }\n  });\n}\n\n// If no logs, create a summary log\nif (logEntries.length === 0) {\n  logEntries.push({\n    json: {\n      event_type: 'unified_monitor',\n      severity: 'info',\n      source: 'unified',\n      route: '/api/unified-monitor',\n      message: 'Monitoring cycle completed: ' + results.agents.filter(a => a.ran).length + ' agents ran',\n      metadata: JSON.stringify(results),\n      created_at: results.timestamp\n    }\n  });\n}\n\nreturn logEntries;"
      },
