    {
      "parameters": {
        "jsCode": "// Prepare data for auto-remediation\nconst input = $input.first().json;\nconst failedKpis = input.results\n  .filter(r => r.overallStatus === 'fail')\n  .map(r => r.kpiSlug);\n\nreturn [{\n  json: {\n    failedKpis,\n    retryCount: 1,\n    maxRetries: 3,\n    originalResults: input.results,\n    originalSummary: input.summary,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "prepare-remediation",
      "name": "Prepare Remediation Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
