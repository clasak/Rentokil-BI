      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app/api/health/kpis",
        "options": {
          "timeout": 15000
        }
      },
      "id": "get-kpi-health",
      "name": "Get KPI Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "jsCode": "// Process KPI data and check thresholds\nconst input = $input.first().json;\nconst kpis = input.kpis || [];\nconst anomalies = input.anomalies || [];\n\nconst results = [];\nlet hasCritical = false;\nlet hasWarning = false;\nconst criticalKpis = [];\nconst warningKpis = [];\n\n// Map API status to database status (ok -> good)\nfunction mapStatus(apiStatus) {\n  if (apiStatus === 'ok') return 'good';\n  if (['good', 'warning', 'critical', 'neutral'].includes(apiStatus)) return apiStatus;\n  return 'neutral';\n}\n\nfor (const kpi of kpis) {\n  const apiStatus = kpi.status || 'ok';\n  const dbStatus = mapStatus(apiStatus);\n  \n  if (apiStatus === 'critical') {\n    hasCritical = true;\n    criticalKpis.push(kpi.slug);\n  } else if (apiStatus === 'warning') {\n    hasWarning = true;\n    warningKpis.push(kpi.slug);\n  }\n  \n  results.push({\n    kpi_slug: kpi.slug,\n    value: kpi.value,\n    status: dbStatus,\n    variance_pct: kpi.variance_pct || null,\n    source: 'tommy',\n    reason: kpi.reason || null\n  });\n}\n\n// Return as proper n8n item with json property\nreturn [{\n  json: {\n    kpis: results,\n    hasCritical,\n    hasWarning,\n    criticalKpis,\n    warningKpis,\n    anomalies,\n    overallStatus: input.status,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "check-thresholds",
      "name": "Check Thresholds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Return individual KPI for batch insert\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (data && data.kpis && Array.isArray(data.kpis)) {\n    for (const kpi of data.kpis) {\n      results.push({ json: kpi });\n    }\n  }\n}\n\nreturn results.length > 0 ? results : [{ json: { error: 'No KPIs to process' } }];"
      },
      "id": "split-kpis",
      "name": "Split KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "kpi_snapshots",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "kpi_slug": "={{ $json.kpi_slug }}",
            "value": "={{ $json.value }}",
            "status": "={{ $json.status }}",
            "variance_pct": "={{ $json.variance_pct }}",
            "source": "tommy",
            "captured_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "insert-snapshots",
      "name": "Insert Snapshots",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [880, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Supabase-Prod"
        }
      }
    },
    {
