{
  "name": "OPS-RTX-INTAKE-001 Data Intake",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app/api/rtx/health",
        "options": {
          "timeout": 15000
        }
      },
      "id": "check-rtx-health",
      "name": "Check RTX Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "rtx-healthy",
              "leftValue": "={{ $json.status }}",
              "rightValue": "healthy",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "is-rtx-healthy",
      "name": "Is RTX Healthy?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "// Check if schema discovery is needed\n// Run daily or on first connect\nconst now = new Date();\nconst hour = now.getUTCHours();\nconst minute = now.getMinutes();\n\n// Run schema discovery at midnight UTC or if explicitly requested\nconst shouldDiscoverSchema = (hour === 0 && minute < 15);\n\nreturn [{\n  json: {\n    shouldDiscoverSchema,\n    rtxHealth: $input.first().json,\n    timestamp: now.toISOString()\n  }\n}];"
      },
      "id": "check-schema-discovery",
      "name": "Check Schema Discovery Need",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "should-discover",
              "leftValue": "={{ $json.shouldDiscoverSchema }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-discovery",
      "name": "Needs Discovery?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app/api/rtx/discover",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"force\": false\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "run-discovery",
      "name": "Run Schema Discovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_RTX_API_CREDENTIAL_ID",
          "name": "RTX-API-Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-changes",
              "leftValue": "={{ $json.changes.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-schema-changes",
      "name": "Has Schema Changes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, -200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "REPLACE_WITH_SLACK_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"attachments\": [\n    {\n      \"color\": \"#2196F3\",\n      \"blocks\": [\n        {\n          \"type\": \"header\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"ℹ️ RTX Schema Changes Detected\",\n            \"emoji\": true\n          }\n        },\n        {\n          \"type\": \"section\",\n          \"fields\": [\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*Changes Detected:*\\n{{ $json.changes.length }}\"\n            },\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"*Fields Registered:*\\n{{ $json.registered }}\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"text\": {\n            \"type\": \"mrkdwn\",\n            \"text\": \"*Changes:*\\n{{ $json.changes.slice(0, 10).map(c => '• ' + c.entity + '.' + c.field + ': ' + c.change + (c.previous_type ? ' (' + c.previous_type + ' → ' + c.current_type + ')' : '')).join('\\n') }}{{ $json.changes.length > 10 ? '\\n... and ' + ($json.changes.length - 10) + ' more' : '' }}\"\n          }\n        },\n        {\n          \"type\": \"context\",\n          \"elements\": [\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"Agent: RTX Intake | {{ $now.toISO() }}\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "slack-schema-changes",
      "name": "Slack Schema Changes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, -300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app/api/rtx/sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"type\": \"incremental\"\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "run-sync",
      "name": "Run Data Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 100],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_RTX_API_CREDENTIAL_ID",
          "name": "RTX-API-Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "sync-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "sync-succeeded",
      "name": "Sync Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 100]
    },
    {
