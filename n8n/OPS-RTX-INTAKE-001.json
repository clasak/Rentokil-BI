        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"attachments\": [\n    {\n      \"color\": \"#FFA500\",\n      \"blocks\": [\n        {\n          \"type\": \"header\",\n          \"text\": {\n            \"type\": \"plain_text\",\n            \"text\": \"⚠️ RTX Data Integrity Issues\",\n            \"emoji\": true\n          }\n        },\n        {\n          \"type\": \"section\",\n          \"text\": {\n            \"type\": \"mrkdwn\",\n            \"text\": \"*Overall Status:* {{ $json.overall_status }}\"\n          }\n        },\n        {\n          \"type\": \"section\",\n          \"text\": {\n            \"type\": \"mrkdwn\",\n            \"text\": \"*Issues:*\\n{{ ($json.checks || []).filter(c => c.status !== 'ok').map(c => '• ' + c.entity + ': ' + c.status + ' (' + (c.issues || []).slice(0, 2).join(', ') + ')').join('\\n') }}\"\n          }\n        },\n        {\n          \"type\": \"context\",\n          \"elements\": [\n            {\n              \"type\": \"mrkdwn\",\n              \"text\": \"Agent: RTX Intake | {{ $now.toISO() }}\"\n            }\n          ]\n        },\n        {\n          \"type\": \"actions\",\n          \"elements\": [\n            {\n              \"type\": \"button\",\n              \"text\": {\n                \"type\": \"plain_text\",\n                \"text\": \"View Data Sources\"\n              },\n              \"url\": \"https://rentokil-bi-git-alpha-test-clasaks-projects.vercel.app/settings/data-sources\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
