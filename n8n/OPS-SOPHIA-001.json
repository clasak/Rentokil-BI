            "severity": "={{ $('Process Feedback').item.json.summary.critical > 0 ? 'critical' : $('Process Feedback').item.json.summary.high > 0 ? 'high' : 'info' }}",
            "source": "sophia",
            "message": "={{ 'Sophia triaged ' + $('Process Feedback').item.json.summary.total + ' feedback items (' + $('Process Feedback').item.json.summary.critical + ' critical, ' + $('Process Feedback').item.json.summary.high + ' high)' }}",
            "metadata": "={{ JSON.stringify($('Process Feedback').item.json.summary) }}",
            "created_at": "={{ $now.toISO() }}"
          }
        },
        "options": {}
      },
      "id": "log-batch-summary",
