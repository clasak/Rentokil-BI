      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "select",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "governance_snapshots",
          "mode": "list"
        },
        "limit": 1,
        "sort": {
          "values": [
            {
              "column": "created_at",
              "direction": "DESC"
            }
          ]
        },
        "options": {}
      },
      "id": "get-previous-snapshot",
      "name": "Get Previous Snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [220, 200],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Supabase-Prod"
        }
      }
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "merge-data",
      "name": "Merge Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [440, 100]
    },
    {
      "parameters": {
        "jsCode": "// Compare current definitions with previous snapshot\nconst items = $input.all();\nconst current = items[0]?.json || {};\nconst previous = items[1]?.json || {};\n\nconst currentHash = current.hash || '';\nconst previousHash = previous.snapshot_hash || '';\n\n// Check if this is the first run (no previous snapshot)\nconst isFirstRun = !previousHash;\n\n// Check if definitions have changed\nconst hasChanged = !isFirstRun && currentHash !== previousHash;\n\n// If changed, find what changed\nconst changes = [];\nif (hasChanged && current.definitions && previous.snapshot_data) {\n  const currentDefs = current.definitions;\n  const prevDefs = typeof previous.snapshot_data === 'string' \n    ? JSON.parse(previous.snapshot_data) \n    : previous.snapshot_data;\n  \n  // Create lookup maps\n  const currentMap = new Map(currentDefs.map(d => [d.slug, d]));\n  const prevMap = new Map((prevDefs.definitions || prevDefs).map(d => [d.slug, d]));\n  \n  // Check for new, removed, or modified KPIs\n  for (const [slug, def] of currentMap) {\n    const prevDef = prevMap.get(slug);\n    if (!prevDef) {\n      changes.push({\n        kpi_slug: slug,\n        change_type: 'new',\n        old_value: null,\n        new_value: def,\n        change_summary: `New KPI added: ${def.name}`\n      });\n    } else {\n      // Check specific fields for changes\n      const fieldsToCheck = ['definition', 'formula', 'warningThreshold', 'criticalThreshold', 'owner', 'primarySource'];\n      for (const field of fieldsToCheck) {\n        if (JSON.stringify(def[field]) !== JSON.stringify(prevDef[field])) {\n          let changeType = 'definition';\n          if (field.includes('Threshold')) changeType = 'threshold';\n          else if (field === 'owner') changeType = 'ownership';\n          else if (field === 'primarySource') changeType = 'source';\n          \n          changes.push({\n            kpi_slug: slug,\n            change_type: changeType,\n            field_changed: field,\n            old_value: { [field]: prevDef[field] },\n            new_value: { [field]: def[field] },\n            change_summary: `${def.name}: ${field} changed from \"${prevDef[field]}\" to \"${def[field]}\"`\n          });\n        }\n      }\n    }\n  }\n  \n  // Check for removed KPIs\n  for (const [slug, def] of prevMap) {\n    if (!currentMap.has(slug)) {\n      changes.push({\n        kpi_slug: slug,\n        change_type: 'deprecated',\n        old_value: def,\n        new_value: null,\n        change_summary: `KPI removed: ${def.name}`\n      });\n    }\n  }\n}\n\nreturn {\n  isFirstRun,\n  hasChanged,\n  currentHash,\n  previousHash,\n  kpi_count: current.kpi_count || 0,\n  changes,\n  changeCount: changes.length,\n  definitions: current.definitions || [],\n  timestamp: new Date().toISOString()\n};"
      },
      "id": "compare-definitions",
      "name": "Compare Definitions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 100]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-changes",
              "leftValue": "={{ $json.hasChanged }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-changes",
      "name": "Has Changes?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [880, 100]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Return individual changes for batch insert\nconst item = $input.item.json;\nif (item.changes && item.changes.length > 0) {\n  return item.changes.map(change => ({ json: change }));\n}\nreturn [];"
      },
      "id": "split-changes",
      "name": "Split Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
