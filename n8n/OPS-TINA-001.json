            "change_type": "={{ $json.change_type }}",
            "old_value": "={{ JSON.stringify($json.old_value) }}",
            "new_value": "={{ JSON.stringify($json.new_value) }}",
            "field_changed": "={{ $json.field_changed || null }}",
            "change_summary": "={{ $json.change_summary }}",
            "changed_by": "system",
            "approval_status": "pending"
          }
        },
        "options": {}
      },
